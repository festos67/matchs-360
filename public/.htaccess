# ============================================================
# matchs-360 — configuration Apache (OVH mutualisé)
# Headers de sécurité + redirection HTTPS + fallback SPA + compression.
# ============================================================

# --- 1. Forcer HTTPS (doit précéder le fallback SPA) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- 2. Compression : servir les fichiers pré-compressés au build ---
# mod_deflate n'est PAS chargé sur cet hébergement : la directive
# AddOutputFilterByType (section 6) est ignorée silencieusement et tout était
# servi brut (~700 Ko au premier chargement). Vite génère donc les variantes
# .br et .gz (voir vite.config.ts, plugin precompress-assets) et on les sert
# ici par réécriture quand le navigateur les accepte.
#
# ORDRE CRITIQUE : ce bloc doit rester AVANT le fallback SPA. Celui-ci se
# termine par `RewriteRule ^ - [L]` sur les fichiers existants, ce qui stoppe
# net le moteur de réécriture — des règles placées après ne s'exécuteraient
# jamais pour les assets.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Brotli en priorité (meilleur taux), sinon gzip.
  RewriteCond %{HTTP:Accept-Encoding} (^|,)\s*br(\s*,|\s*$) [NC]
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.*)$ $1.br [QSA,L]

  RewriteCond %{HTTP:Accept-Encoding} (^|,)\s*gzip(\s*,|\s*$) [NC]
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule ^(.*)$ $1.gz [QSA,L]
</IfModule>

# Rétablir le type MIME réel (sinon Apache annonce application/x-gzip) et
# déclarer l'encodage pour que le navigateur décompresse.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs)\.(gz|br)$">
    ForceType application/javascript
  </FilesMatch>
  <FilesMatch "\.css\.(gz|br)$">
    ForceType text/css
  </FilesMatch>
  <FilesMatch "\.html\.(gz|br)$">
    ForceType text/html
  </FilesMatch>
  <FilesMatch "\.svg\.(gz|br)$">
    ForceType image/svg+xml
  </FilesMatch>
  <FilesMatch "\.json\.(gz|br)$">
    ForceType application/json
  </FilesMatch>

  <FilesMatch "\.gz$">
    Header set Content-Encoding gzip
    Header append Vary Accept-Encoding
  </FilesMatch>
  <FilesMatch "\.br$">
    Header set Content-Encoding br
    Header append Vary Accept-Encoding
  </FilesMatch>
</IfModule>

# --- 3. Fallback SPA : routes inconnues -> index.html (React Router) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Ne pas réécrire les fichiers et dossiers réellement présents (assets…)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Tout le reste -> index.html
  RewriteRule ^ index.html [L]
</IfModule>

# --- 4. Headers de sécurité (auparavant servis par Cloudflare/Lovable) ---
<IfModule mod_headers.c>
  # HSTS : forcer HTTPS 2 ans, sous-domaines inclus, éligible preload.
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  # Anti-clickjacking (legacy ; la CSP frame-ancestors 'none' couvre les navigateurs récents).
  Header always set X-Frame-Options "DENY"
  # Anti MIME-sniffing.
  Header always set X-Content-Type-Options "nosniff"
  # Référent minimal inter-origines.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Réduire la surface d'API navigateur.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- 5. Cache ---
<IfModule mod_headers.c>
  # index.html jamais mis en cache : chaque déploiement prend effet immédiatement.
  # Les variantes .gz/.br doivent suivre la MÊME règle, sinon un index.html
  # compressé resterait figé en cache et masquerait les nouveaux déploiements.
  <FilesMatch "index\.html(\.(gz|br))?$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  # Assets hashés par Vite : cache long immuable (variantes compressées incluses).
  <FilesMatch "\.(js|mjs|css|woff2?|png|jpe?g|gif|svg|webp|ico)(\.(gz|br))?$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# --- 6. Compression à la volée (inopérante ici : mod_deflate non chargé) ---
# Conservée au cas où le module serait activé un jour ; la section 2 reste la
# solution effective. Les fichiers déjà servis en .gz/.br ne sont pas
# re-compressés (Apache n'applique pas le filtre si Content-Encoding est posé).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# --- 7. Refuser l'accès aux fichiers sensibles éventuellement déployés ---
<FilesMatch "^\.(env|git)">
  Require all denied
</FilesMatch>
